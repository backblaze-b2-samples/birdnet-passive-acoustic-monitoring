  "info": {
    "description": "Passive-acoustic-monitoring API: ingest field recordings, run on-device BirdNET species detection, and store detections + event clips on Backblaze B2",
    "title": "BirdNET Passive Acoustic Monitoring API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/files": {
      "get": {
        "operationId": "list_files_endpoint_files_get",
        "parameters": [
          {
            "in": "query",
            "name": "prefix",
            "required": false,
            "schema": {
              "default": "",
              "title": "Prefix",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 100,
              "title": "Limit",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
