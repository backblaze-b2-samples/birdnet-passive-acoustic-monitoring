{
  "name": "birdnet-passive-acoustic-monitoring",
  "private": true,
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "doctor": "node scripts/doctor.mjs",
    "predev": "node scripts/doctor.mjs",
    "dev": "sh scripts/dev.sh",
    "dev:web": "pnpm --filter @birdnet-pam/web dev",
    "dev:api": "cd services/api && .venv/bin/uvicorn main:app --reload --port ${API_PORT:-8000}",
    "build": "pnpm --filter @birdnet-pam/web build",
    "typecheck": "pnpm --filter @birdnet-pam/web typecheck",
    "contract:export": "services/api/.venv/bin/python services/api/scripts/export_openapi.py",
    "contract:check": "services/api/.venv/bin/python services/api/scripts/export_openapi.py --check && pnpm --filter @birdnet-pam/web exec vitest run src/lib/api-contract.test.ts",
    "check:agent-docs": "node scripts/check-agent-docs.mjs",
    "verify": "pnpm check:agent-docs && pnpm verify:api && pnpm verify:web",
    "verify:api": "pnpm lint:api && pnpm test:api && pnpm check:structure",
    "verify:web": "pnpm lint && pnpm test:web && pnpm build",
    "verify:full": "pnpm run doctor && pnpm verify && pnpm test:e2e",
    "lint": "pnpm --filter @birdnet-pam/web lint",
    "lint:api": "cd services/api && .venv/bin/ruff check .",
    "test:web": "pnpm --filter @birdnet-pam/web test",
    "test:api": "cd services/api && .venv/bin/python -m pytest",
    "check:structure": "cd services/api && .venv/bin/python -m pytest tests/test_structure.py -v",
    "test:e2e": "pnpm --filter @birdnet-pam/web exec playwright test"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  },
  "engines": {
    "node": ">=20.19.0",
    "pnpm": ">=9"
  },
  "pnpm": {
    "overrides": {
      "@babel/core": "7.29.6",
      "@humanfs/node": "0.16.8",
      "@hono/node-server": "1.19.15",
      "ajv@>=8 <9": "8.18.0",
      "browserslist": "4.28.7",
      "body-parser@>=2.0.0 <2.3.0": "2.3.0",
      "brace-expansion@<2": "1.1.18",
      "brace-expansion@>=2 <3": "2.1.4",
      "express-rate-limit@>=8.2.0 <8.2.2": "8.2.2",
      "fast-uri@>=3 <4": "3.1.6",
      "flatted": "3.4.2",
      "hono": "4.12.34",
      "ip-address": "10.3.1",
      "js-yaml": "4.3.1",
      "lodash@>=4 <5": "4.17.21",
      "minimatch@<4": "3.1.4",
      "minimatch@>=9 <10": "9.0.7",
      "minimatch@>=10 <11": "10.2.3",
      "path-to-regexp@>=8 <9": "8.4.0",
      "picomatch@<3": "2.3.2",
      "picomatch@>=4 <5": "4.0.4",
      "postcss": "8.5.23",
      "postcss-selector-parser@>=7 <8": "7.1.3",
      "qs@>=6 <7": "6.16.0",
      "socks": "2.8.9",
      "vite": "8.0.16"
    }
  }
}
